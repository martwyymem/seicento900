extends SceneTree
func _initialize() -> void:
	var t := Time.get_ticks_usec()
	var h := FileAccess.get_md5("res://data/world/brzeszcze.json")
	print("md5 json %.0f ms" % [(Time.get_ticks_usec() - t) / 1000.0])
	t = Time.get_ticks_usec()
	var b := FileAccess.get_file_as_bytes("res://data/world/brzeszcze.json")
	print("read bytes %.0f ms" % [(Time.get_ticks_usec() - t) / 1000.0])
	t = Time.get_ticks_usec()
	var ctx := HashingContext.new()
	ctx.start(HashingContext.HASH_MD5)
	ctx.update(b)
	ctx.finish()
	print("hash ctx md5 %.0f ms" % [(Time.get_ticks_usec() - t) / 1000.0])
	t = Time.get_ticks_usec()
	ctx.start(HashingContext.HASH_SHA1)
	ctx.update(b)
	ctx.finish()
	print("sha1 %.0f ms" % [(Time.get_ticks_usec() - t) / 1000.0])
	quit()
